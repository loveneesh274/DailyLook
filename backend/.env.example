# Database — use SQLite for local dev (zero install, file-based)
DATABASE_URL=sqlite+aiosqlite:///./dailylook.db
# Switch to PostgreSQL later:
# DATABASE_URL=postgresql+psycopg://dailylook:dailylook123@localhost:5432/dailylook

# JWT Auth
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Groq (free — get key at console.groq.com)
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=dailylook-uploads

# OpenWeatherMap (free tier)
OPENWEATHERMAP_API_KEY=your-openweathermap-key
OPENWEATHERMAP_BASE_URL=https://api.openweathermap.org/data/2.5

# Remove.bg (free: 50 images/month)
REMOVE_BG_API_KEY=your-removebg-key

# Affiliate IDs (India)
AMAZON_AFFILIATE_TAG=your-amazon-tag-21
FLIPKART_AFFILIATE_ID=your-flipkart-id
MYNTRA_AFFILIATE_ID=your-myntra-id
AJIO_AFFILIATE_ID=your-ajio-id

# App
APP_ENV=development
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
